# 复制为 .env 并修改为你的配置
# ===== LLM 后端（默认本地 Ollama deepseek-r1:7b，Agent 工具调用模式）=====
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

# ===== 嵌入 / 重排（本地 BGE；有 NVIDIA GPU 且 torch 为 cu 版设 cuda，否则 cpu）=====
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
DEVICE=cuda
USE_RERANKER=true
USE_BM25=true

# ===== 向量库（默认 Milvus，FAISS 备选）=====
VECTOR_DB=milvus
MILVUS_URI=http://localhost:19530
MILVUS_INDEX_TYPE=IVF_SQ8
FAISS_DIR=./faiss_db

# ===== 路径 =====
DATA_DIR=D:\2-Agent\datas
CACHE_DIR=./data_cache
API_PORT=8000
